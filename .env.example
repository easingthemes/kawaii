# TinaCloud project "kawaii" — https://app.tina.io
# The client ID is public: it ships to the browser as a NEXT_PUBLIC_* value.
NEXT_PUBLIC_TINA_CLIENT_ID=be9b3b32-6fcf-4d09-844d-dcf4e5dcc509

# SECRET. Read/write token from the same TinaCloud project. Never commit the real value.
TINA_TOKEN=

# Which branch TinaCloud reads and writes content on.
#
# In Vercel, scope this to Production only. Set for Preview as well it wins over the
# fallback chain in tina/config.tsx, and every preview branch then edits content on
# main — so a draft on a branch quietly writes to the live site. Left unset for
# Preview, Vercel's own NEXT_PUBLIC_VERCEL_GIT_COMMIT_REF fills in the real branch.
NEXT_PUBLIC_TINA_BRANCH=main
