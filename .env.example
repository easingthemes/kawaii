# Service account JSON (raw, no surrounding quotes). The SA must have Drive
# and Docs APIs enabled; the root folder must be shared with its email.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"kawaii-sync@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# Drive folder ID — the part after /folders/ in the URL.
ROOT_FOLDER_ID=1AbCDeFGhIjKlMnOpQrStUvWxYz

# Astro site config (for `npm run build` locally; in CI these come from
# repository "Variables", not secrets).
SITE_URL=https://easingthemes.github.io
BASE_PATH=/kawaii/
