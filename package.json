    "tailwindcss": "^4.1.15",
    "tinacms": "^3.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tinacms/cli": "^2.5.3",
    "@types/node": "^22.18.12",
