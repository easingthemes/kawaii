---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="Kawaii">
  {articles.length === 0 ? (
    <p>No articles yet. Run <code>npm run sync:docs</code> to pull from Drive.</p>
  ) : (
    <ul class="article-list">
      {articles.map((a) => (
        <li>
          <p class="meta">
            {a.data.category}
            {a.data.location && <> · {a.data.location}</>}
            <> · {fmt(a.data.publishedAt)}</>
          </p>
          <h2><a href={`/${a.id}/`}>{a.data.title}</a></h2>
          {a.data.summary && <p>{a.data.summary}</p>}
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
